# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets and local config: never committed
.env
*.env

# Terraform (task 4): state and plans can contain secrets and resource details
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Values that stay on Han's machine: the backend file names the state bucket, tfvars hold local values
backend.hcl
*.tfvars
!*.tfvars.example
# The function package Terraform builds from pipeline/ and detections/ at plan time
.build/

# Raw captures and recordings from tests and game days: they hold account IDs, IPs and
# tokens. Only scrubbed fixtures are committed
taotie/

# Local tooling caches
.impeccable/
