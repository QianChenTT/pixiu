# Copy to backend.hcl (ignored by git). This folder keeps its state in the management
# account's state bucket, so the two values are the same as in infra/management/backend.hcl:
#   cp ../management/backend.hcl backend.hcl
# Then: terraform init -backend-config=backend.hcl

bucket  = "shanhai-mgmt-tfstate-REPLACE_ME"
profile = "shanhai-mgmt"
